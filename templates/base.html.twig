<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        
        <title>{% block title %}Welcome!{% endblock %}</title>
        
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

        {# --- Webpack Encore : Styles --- #}
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {# --- Webpack Encore : JavaScript --- #}
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}

        {# --- Configuration FrankenPHP Hot Reload --- #}
        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
            <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
            <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
            <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    
    <body>
        {# Navbar dynamique #}
        <header class="navbar">
            <div class="logo">🎀 KittyLand</div>

            <div class="search-box">
                <span class="search-icon">🔍</span>
                <input class="search" type="text" placeholder="Recherche...">
            </div>

            <nav class="menu">
                <a href="{{ path('home') }}" class="{% if app.request.attributes.get('_route') == 'home' %}active{% endif %}">Accueil</a>
                <a href="{{ path('app_gallery') }}" class="{% if app.request.attributes.get('_route') == 'app_gallery' %}active{% endif %}">Galerie</a>
                <a href="{{ path('app_produit') }}" class="{% if app.request.attributes.get('_route') == 'app_produit' %}active{% endif %}">Billetterie</a>
                
                {% if app.user %}
                    <span class="user-greeting">Bonjour {{ app.user.pseudo }} !</span>
                    <a href="/logout" class="btn dark" onclick="return confirm('Déconnexion ?')">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn pink">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn pink-outline">Inscription</a>
                {% endif %}
            </nav>
        </header>

        {% block body %}{% endblock %}
    </body>
</html>