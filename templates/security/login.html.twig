{% extends 'base.html.twig' %}

{% block title %}Connexion - KittyLand{% endblock %}

{% block body %}
<!-- Navbar comme produit/home -->


<!-- Hero connexion -->
<section class="hero login-hero">
    <div class="hero-content">
        <h1>🎀 Bienvenue à KittyLand</h1>
        <p>Connectez-vous pour réserver votre aventure magique ✨</p>
    </div>
</section>

<!-- Formulaire centré -->
<section class="auth-container">
    <form method="post" class="auth-form">
        
        {% if error %}
            <div class="error-message">Identifiants incorrects 😿</div>
        {% endif %}

        <h2>Connexion</h2>
        
        <div class="input-group">
            <label>Email</label>
            <div class="input-wrapper">
                <span class="input-icon">✉️</span>
                <input type="email" name="email" value="{{ last_username }}" required autofocus>
            </div>
        </div>

        <div class="input-group">
            <label>Mot de passe</label>
            <div class="input-wrapper">
                <span class="input-icon">🔒</span>
                <input type="password" name="password" required>
            </div>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <label class="checkbox-group">
            <input type="checkbox" name="_remember_me">
            Se souvenir de moi
        </label>

        <button class="btn pink login-btn" type="submit">
            <span>Se connecter</span>
            <span class="btn-icon">🚀</span>
        </button>

        <p class="forgot-password">
            <a href="#">Mot de passe oublié ?</a>
        </p>
        
    </form>
</section>
{% endblock %}
