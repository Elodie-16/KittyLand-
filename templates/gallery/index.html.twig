{% extends 'base.html.twig' %}

{% block title %}Galerie - KittyLand{% endblock %}

{% block body %}

<header class="navbar">
    <div class="logo">🎀</div>

    <div class="search-box">
        <span class="search-icon">🔍</span>
        <input class="search" type="text" placeholder="Recherche...">
        
    </div>

    <nav class="menu">
        <a href="{{ path('home') }}">Accueil</a>
        <a href="{{ path('app_gallery') }}" class="active">Galerie</a>
        <a href="{{ path('app_produit') }}">Billetterie</a>
        <a href="{{ path('app_login') }}" class="btn pink">Connexion</a>
